# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed browser origin for Express and Socket.IO CORS
CLIENT_URL=http://127.0.0.1:5173

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mmm_db?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=24h
APPROVED_CAMPUS_EMAIL_DOMAINS=campus.example.org

# Agora.io WebRTC Credentials
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate